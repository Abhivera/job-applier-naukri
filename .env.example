# =============================================================================
# AutoApplyNukari — copy via:  python setup_bot.py
# Or manually:  cp .env.example .env
#
# .env is gitignored. Never commit real email / password / API keys.
# =============================================================================

# =============================================================================
# REQUIRED — bot cannot auto-login without these
# =============================================================================
NAUKRI_EMAIL=you@example.com
NAUKRI_PASSWORD=

# =============================================================================
# Candidate identity (dynamic — no code changes needed)
# =============================================================================
CANDIDATE_NAME=Your Name
PROFILE_SUMMARY=Software engineer with N+ years experience. Seeking roles in YOUR_STACK. Prefer startups or mid-size companies. Open to remote, hybrid, or onsite.
YEARS_OF_EXPERIENCE=3+
MIN_SALARY_LPA=8
EXPECTED_CTC_LPA=8
CURRENT_CITY=
PINCODE=
NOTICE_PERIOD=Will confirm
WILLING_TO_RELOCATE=Yes
LINKEDIN_URL=
GITHUB_URL=
PORTFOLIO_URL=

# Path to filled profile memory (relative to project root or absolute)
PROFILE_MEMORY_PATH=profile_memory.md

# Optional: local resume copy (PDF/DOC/DOCX). Used for your records / check-config.
# Upload the same file on Naukri.com profile if you want recruiters to see it.
RESUME_PATH=

# Comma-separated skills for fast screening answers (Yes / years-in-skill)
SKILL_HINTS=python, javascript, typescript, react, node, sql, aws, docker

# =============================================================================
# Browser / Chrome
# =============================================================================
CHROME_DRIVER_PATH=
CHROME_PROFILE_DIR=chrome_profile
HEADLESS=false
# Start with true until you are ready to submit real applications
DRY_RUN=true
CHROME_DEBUGGING_PORT=

# =============================================================================
# Job search (edit freely for any role)
# =============================================================================
KEYWORDS=Software Engineer, Backend Developer, Full Stack Developer
LOCATIONS=Bangalore, Hyderabad, Pune, Chennai, Noida, Gurugram
EXPERIENCE=3+ years
SALARY=8-16 Lakhs
JOB_AGE=1

TITLE_INCLUDE_KEYWORDS=Software Engineer, Backend, Full Stack, API, Python, Node
TITLE_EXCLUDE_KEYWORDS=QA, Tester, Intern, Fresher, Sales, HR, Support, Helpdesk, Java
COMPANY_EXCLUDE_KEYWORDS=TCS, Infosys, Wipro, Accenture, Cognizant, Capgemini, IBM, HCL Technologies, Tech Mahindra

WORK_MODES=remote, hybrid, onsite
PREFERRED_COMPANY_TYPES=startup, mid-size

# =============================================================================
# Limits (Naukri allows ~50 applications per account per day)
# =============================================================================
MAX_PAGES=5
MAX_JOBS_PER_PAGE=20
# Cap per bot run / schedule window
MAX_APPLICATIONS=15
# Stop when today's data/<date>Applied.txt count reaches this (Naukri ~50/day)
DAILY_APPLY_LIMIT=50
WAIT_SECONDS=15
LOGIN_TIMEOUT_SECONDS=1800

# =============================================================================
# IST scheduler — python schedule_bot.py  (or: python Main.py --schedule)
# =============================================================================
SCHEDULE_TIMEZONE=Asia/Kolkata
# Comma-separated HH:MM-HH:MM windows in that timezone
SCHEDULE_WINDOWS=09:30-11:00,13:00-14:00,17:30-18:00

# =============================================================================
# LLM — only used when Apply shows screening / chatbot questions
# =============================================================================
LLM_ENABLED=true
# groq | ollama
LLM_PROVIDER=groq
LLM_MAX_TOKENS=256
LLM_TEMPERATURE=0.2

# Groq — https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Ollama — https://ollama.com/
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
